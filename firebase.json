{
  "hosting": {
    "site": "crimson-playbook",
    "public": "dist",
    "ignore": ["**/.*", "**/node_modules/**"],
    "headers": [
      {"source": "/", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "/{index,business,individuals,certifications}.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "/{account-navigation,navigation}.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "/styles.css", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "/crimson/defensive-stance-builder{,/index.html,/}", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "/crimson/{baseline-screen-slip,closeout-contain,dribble-at-backdoor,five-out,gap-help-recover,hit-find-get,laker-drill}{,/index.html,/}", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "/crimson{,/index.html,/}", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "/crimson/admin{,/index.html,/}", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "/crimson/assets/{play-access,access-model,admin,library,catalog}.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "/crimson/content/baseline-screen-slip.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
    ],
    "redirects": [
      {"regex": "^/crimson/admin[.]html$", "destination": "/crimson/admin/", "type": 301},
      {"regex": "^/crimson/firebase-setup[.]html$", "destination": "/crimson/firebase-setup/", "type": 301},
      {"regex": "^/crimson/guide[.]html$", "destination": "/crimson/coach-guide/", "type": 301},
      {"regex": "^/crimson/position-guide[.]html$", "destination": "/crimson/position-guide/", "type": 301},
      {"regex": "^/crimson/rebound-ball-security[.]html$", "destination": "/crimson/rebound-ball-security/", "type": 301},
      {"regex": "^/crimson/defensive-stance[.]html$", "destination": "/crimson/defensive-stance/", "type": 301},
      {"regex": "^/crimson/reverse-pivot[.]html$", "destination": "/crimson/reverse-pivot/", "type": 301},
      {"regex": "^/crimson/front-pivot[.]html$", "destination": "/crimson/front-pivot/", "type": 301},
      {"regex": "^/crimson/shot-contest[.]html$", "destination": "/crimson/shot-contest/", "type": 301},
      {"regex": "^/crimson/legal-screen[.]html$", "destination": "/crimson/legal-screen/", "type": 301},
      {"regex": "^/crimson/protect-retreat[.]html$", "destination": "/crimson/protect-retreat/", "type": 301},
      {"regex": "^/crimson/catch-stop-read[.]html$", "destination": "/crimson/catch-stop-read/", "type": 301}
    ]
  }
}
