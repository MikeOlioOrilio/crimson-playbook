rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      // Administrator grants are managed in the Firebase console, never by this website.
      allow list, write: if false;
    }
    match /settings/team {
      allow get: if true;
      allow list, delete: if false;
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['title', 'note', 'selectedSlugs', 'revision', 'updatedAt'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 100
        && request.resource.data.note is string && request.resource.data.note.size() <= 1500
        && request.resource.data.selectedSlugs is list && request.resource.data.selectedSlugs.size() <= 500
        && request.resource.data.revision is int && request.resource.data.revision > 0
        && request.resource.data.updatedAt == request.time;
    }
    match /coaches/{coachId} {
      allow read: if admin();
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'enabled', 'credentialId', 'updatedAt'])
        && request.resource.data.firstName is string && request.resource.data.firstName.size() > 0 && request.resource.data.firstName.size() <= 80
        && request.resource.data.lastName is string && request.resource.data.lastName.size() > 0 && request.resource.data.lastName.size() <= 80
        && request.resource.data.enabled is bool
        && request.resource.data.credentialId is string && request.resource.data.credentialId.matches('^[a-f0-9]{64}$')
        && request.resource.data.updatedAt == request.time;
      allow delete: if admin();
    }
    match /coachAccess/{credentialId} {
      // PIN-only convenience gate for public static plays, not authorization to edit data.
      // Names and plaintext PINs never appear here. Visitors may check one derived key, not list keys.
      allow get: if credentialId.matches('^[a-f0-9]{64}$');
      allow list: if false;
      allow create, update: if admin()
        && credentialId.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasOnly(['coachId', 'enabled'])
        && request.resource.data.coachId is string
        && request.resource.data.enabled is bool;
      allow delete: if admin();
    }
    match /{document=**} {allow read, write: if false;}
  }
}
